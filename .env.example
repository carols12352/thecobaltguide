# =============================================================================
# Cobalt 5x Merchant Map — Environment Variables
# =============================================================================
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
#
# Never commit `.env.local` or any file containing real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (required)
# -----------------------------------------------------------------------------

# Your Supabase project URL.
# Found in: Supabase Dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase publishable key — safe to expose in the browser.
# Used by client-side auth and public read queries protected by RLS.
# Found in: Supabase Dashboard → Project Settings → API Keys → Publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Supabase secret key — SERVER ONLY, never expose to the browser.
# Bypasses Row Level Security; used for admin operations, summary recalculation,
# and place creation with duplicate detection.
# Found in: Supabase Dashboard → Project Settings → API Keys → Secret key
SUPABASE_SECRET_KEY=your-secret-key

# Legacy keys (still supported as fallback during Supabase migration):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Map Tiles (required for map display)
# -----------------------------------------------------------------------------

# MapTiler API key for map tile rendering.
# Sign up at https://www.maptiler.com/ and create a key.
# Alternatively, use Mapbox — update NEXT_PUBLIC_MAP_STYLE_URL accordingly.
NEXT_PUBLIC_MAP_TILES_API_KEY=your-maptiler-key

# Map style URL. Defaults to OpenFreeMap (free, no key required).
# OpenFreeMap example:
#   https://tiles.openfreemap.org/styles/liberty
# MapTiler example (full POI icons; key appended automatically if not in URL):
#   https://api.maptiler.com/maps/streets-v2/style.json
# Mapbox example:
#   mapbox://styles/mapbox/streets-v12
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# -----------------------------------------------------------------------------
# Geocoding (optional — needed for address search when creating places)
# -----------------------------------------------------------------------------

# Mapbox access token for geocoding / address search.
# Used server-side only in geocoding-service.ts.
# Found in: Mapbox Account → Access Tokens
MAPBOX_ACCESS_TOKEN=your-mapbox-token

# Alternative: Google Places API key (not yet wired; reserved for future use).
# GOOGLE_PLACES_API_KEY=your-google-places-key

# -----------------------------------------------------------------------------
# Application (optional)
# -----------------------------------------------------------------------------

# Public URL of the deployed application (used for OAuth redirect URLs).
# Local: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Rate Limiting — Phase Two (optional)
# -----------------------------------------------------------------------------

# Upstash Redis REST URL for API caching and distributed rate limiting.
# Optional for local development — without it, requests go straight to Supabase.
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io

# Full REST token — SET/DEL/INCR (cache populate + invalidate after reports).
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Read-only REST token — GET only (map, place, search).
# Upstash Console → your database → REST API → Read-Only Token.
# UPSTASH_REDIS_REST_READONLY_TOKEN=your-upstash-read-only-token

# -----------------------------------------------------------------------------
# Monitoring & Analytics (optional)
# -----------------------------------------------------------------------------

# Sentry DSN for error and performance monitoring.
# Found in: Sentry Project Settings → Client Keys (DSN)
# SENTRY_DSN=https://your-key@o000000.ingest.sentry.io/0000000

# Sentry auth token for source map uploads during CI/CD builds.
# SENTRY_AUTH_TOKEN=your-sentry-auth-token

# For hosted Supabase: copy HTML from supabase/templates/*.html into
# Dashboard → Authentication → Email Templates (magic link, confirmation, recovery).
# Use a custom SMTP sender (e.g. Resend) with your domain to reduce spam filtering.

# PostHog project API key for product analytics.
# NEXT_PUBLIC_POSTHOG_KEY=phc_your-posthog-key

# PostHog host (defaults to US cloud if unset).
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# -----------------------------------------------------------------------------
# Email — Phase Two (optional)
# -----------------------------------------------------------------------------

# Resend API key for transactional emails (magic link fallback, notifications).
# RESEND_API_KEY=re_your-resend-key

# From address for outgoing emails.
# RESEND_FROM_EMAIL=noreply@your-domain.com
