# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
# One-time reviewed seed; remove after its successful database replacement.
data/rewards-canada/cobaltcanada-canada-reviewed.json
*.pem
*.p12
*.key
credentials.json
**/credentials.json
.sentryclirc
.npmrc

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets (.env.example is the only exception)
.env*
!.env.example

# vercel
.vercel

# supabase CLI local state (linked project ref, pooler URLs, etc.)
supabase/.temp/
supabase/.branches/

# typescript
*.tsbuildinfo
next-env.d.ts

# turbo / build artifacts
.turbo
